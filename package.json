{
  "name": "moneyapp",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:clean": "expo prebuild --clean && expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "node scripts/generate-typed-routes.js && tsc --noEmit",
    "validate:agent-assets": "node scripts/validate-agent-assets.js",
    "lint": "npm run validate:agent-assets && node scripts/validate-money-formatting.js && node scripts/validate-money-rounding.js && oxlint --type-aware --type-check && node scripts/validate-structural-guards.js",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "doctor": "npx --yes expo-doctor@1.20.1",
    "prebuild:check": "expo prebuild --no-install --platform android && test -d android",
    "ci:local": "npm run format:check && npm run lint && npm run typecheck && jest --ci && npm run doctor && npm run prebuild:check && echo 'CI parity green, safe to push'",
    "prepare": "husky",
    "postinstall": "patch-package",
    "ui:inventory": "node scripts/heroui-inventory.js",
    "design:tokens": "node scripts/design-tokens.js"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hookform/resolvers": "^5.5.7",
    "@react-native-community/datetimepicker": "9.2.1",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.24",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.19",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "heroui-native": "^1.0.11",
    "react": "19.3.0",
    "react-compiler-runtime": "^1.0.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.83.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-unistyles": "^3.3.0",
    "react-native-uuid": "^2.0.4",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.10.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "agent-device": "0.21.13",
    "babel-plugin-react-compiler": "^1.0.0",
    "babel-preset-expo": "~58.0.0",
    "better-sqlite3": "^12.11.1",
    "eslint-plugin-expo": "1.1.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "lint-staged": "^17.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "patch-package": "^8.0.1",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": "^22.22.1 || >=24"
  }
}
