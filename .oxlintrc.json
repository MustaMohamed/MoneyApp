{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "jsx-a11y", "import", "jest"],
  "jsPlugins": [
    {
      "name": "expo",
      "specifier": "eslint-plugin-expo"
    }
  ],
  "env": {
    "browser": true,
    "es2024": true,
    "node": true,
    "jest": true
  },
  "globals": {
    "__DEV__": "readonly",
    "ErrorUtils": "readonly",
    "FormData": "readonly",
    "XMLHttpRequest": "readonly",
    "fetch": "readonly",
    "navigator": "readonly",
    "process": "readonly",
    "requestAnimationFrame": "readonly",
    "cancelAnimationFrame": "readonly",
    "setImmediate": "readonly",
    "clearImmediate": "readonly"
  },
  "settings": {
    "react": {
      "version": "19.2.3"
    }
  },
  "rules": {
    // The jest plugin is enabled for this rule alone: RNTL 14 made the async
    // APIs return Promises, and `expect(p).resolves.X` without `await` passes
    // silently. With ~70 `.resolves` sites now, that footgun needs a guard.
    "jest/valid-expect": "error",
    // The plugin's other default-on rules would add 21 warnings unrelated to
    // this change (17 require-to-throw-message, 3 no-conditional-expect,
    // 1 expect-expect). Worth a look, but on their own branch.
    "jest/require-to-throw-message": "off",
    "jest/no-conditional-expect": "off",
    "jest/expect-expect": "off",
    "react/react-in-jsx-scope": "off",
    "react/display-name": "off",
    "expo/use-dom-exports": "error",
    "expo/no-env-var-destructuring": "error",
    "expo/no-dynamic-env-var": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-redundant-type-constituents": "warn",
    "typescript/prefer-nullish-coalescing": "warn",
    "typescript/prefer-optional-chain": "warn",
    "typescript/unbound-method": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    ".expo/",
    ".claude/",
    "dist/",
    "android/",
    "ios/",
    "coverage/",
    "uniwind.d.ts"
  ],
  "overrides": [
    {
      "files": ["scripts/**/*.{ts,tsx,js}", "metro.config.js", "babel.config.js"],
      "rules": {
        "typescript/no-unsafe-assignment": "warn",
        "typescript/no-explicit-any": "warn",
        "typescript/no-unsafe-return": "warn",
        "typescript/no-unsafe-member-access": "warn",
        "typescript/no-unsafe-call": "warn",
        "typescript/no-unsafe-argument": "warn"
      }
    },
    {
      "files": ["jest.setup.js", "__tests__/**/*.{ts,tsx,js}", "__mocks__/**/*.{ts,tsx,js}"],
      "rules": {
        "react/display-name": "off",
        "typescript/no-unsafe-type-assertion": "warn",
        "typescript/no-explicit-any": "warn",
        "typescript/no-unsafe-assignment": "warn",
        "typescript/no-unsafe-return": "warn",
        "typescript/no-unsafe-member-access": "warn",
        "typescript/no-unsafe-call": "warn",
        "typescript/no-unsafe-argument": "warn",
        // Off, not "warn": jest types requireMock/mockResolvedValue as `any`, so
        // this rule's "the receiver accepts the original type" detection is
        // structurally always true in tests and can only delete intent — it
        // rewrote `as unknown as Response` to `as unknown`. It was also the sole
        // source of a non-deterministic autofix (four identical --fix runs touched
        // 3/5/6/4 different test files). Costs 7 real findings here; worth it.
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-condition": "warn",
        "typescript/no-unsafe-enum-comparison": "warn",
        "typescript/no-floating-promises": "warn",
        "typescript/no-deprecated": "warn"
      }
    }
  ]
}
