{
  "expo": {
    "name": "MoneyApp",
    "slug": "moneyapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "moneyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.moneyapp.app",
      "supportsTablet": false,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.moneyapp.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1923",
          "dark": {
            "backgroundColor": "#0F1923"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
