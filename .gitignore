# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
# No trailing slash: matches node_modules whether it is a directory, a file,
# or a symlink. A stray `node_modules` symlink was previously committable
# because `node_modules/` only matches directories.
node_modules

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# test coverage output
coverage/

# jest transform cache (CI-pinned via --cacheDirectory)
.jest-cache/

app-example

# Claude Code agent worktrees (local tooling state)
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/commands/
!.claude/rules/
!.claude/settings.json

# generated native folders
/ios
/android

/.idea

